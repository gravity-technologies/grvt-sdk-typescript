[
  {
    "name": "read retries a rate limit, then succeeds",
    "call": { "kind": "read" },
    "replies": [
      { "status": 429, "body": { "code": "$rate_limit_code", "message": "slow down", "status": 429 } },
      { "status": 200, "body": { "result": { "instrument": "BTC_USDT_Perp" } } }
    ],
    "expect": { "outcome": "ok", "attempts": 2, "retries": 1 }
  },
  {
    "name": "read retries the first two retry statuses whatever the code",
    "call": { "kind": "read" },
    "replies": [
      { "status": "$read_retry_statuses.0", "body": { "code": 1003, "message": "bad gateway" } },
      { "status": "$read_retry_statuses.1", "body": { "code": 1003, "message": "unavailable" } },
      { "status": 200, "body": { "result": { "instrument": "BTC_USDT_Perp" } } }
    ],
    "expect": {
      "outcome": "ok",
      "attempts": 3,
      "retries": 2,
      "events": [
        { "kind": "retry", "rpc": "v1/ticker", "attempt": 1 },
        { "kind": "retry", "rpc": "v1/ticker", "attempt": 2 }
      ]
    }
  },
  {
    "name": "read retries the third retry status whatever the code",
    "call": { "kind": "read" },
    "replies": [
      { "status": "$read_retry_statuses.2", "body": { "code": 1003, "message": "gateway timeout" } },
      { "status": 200, "body": { "result": { "instrument": "BTC_USDT_Perp" } } }
    ],
    "expect": { "outcome": "ok", "attempts": 2, "retries": 1 }
  },
  {
    "name": "read gives up after the attempt limit",
    "call": { "kind": "read" },
    "replies": [{ "status": 429, "body": { "code": "$rate_limit_code", "message": "slow down", "status": 429 } }],
    "expect": {
      "outcome": "rate_limited",
      "status": 429,
      "attempts": "$read_attempts",
      "retries": "$read_attempts-1"
    }
  },
  {
    "name": "read does not retry a rejection",
    "call": { "kind": "read" },
    "replies": [{ "status": 400, "body": { "code": 1003, "message": "bad", "status": 400 } }],
    "expect": { "outcome": "api_error", "code": 1003, "status": 400, "retryable": false, "attempts": 1, "retries": 0 }
  },
  {
    "name": "read retries a connection refused before sending",
    "call": { "kind": "read" },
    "replies": [{ "refuse": true }, { "status": 200, "body": { "result": { "instrument": "BTC_USDT_Perp" } } }],
    "expect": { "outcome": "ok", "attempts": 2, "retries": 1 }
  },
  {
    "name": "read retries a connection dropped after sending",
    "call": { "kind": "read" },
    "replies": [{ "drop": true }, { "status": 200, "body": { "result": { "instrument": "BTC_USDT_Perp" } } }],
    "expect": { "outcome": "ok", "attempts": 2, "retries": 1 }
  },
  {
    "name": "read with a malformed success body is a decode error",
