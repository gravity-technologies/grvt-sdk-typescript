  {
    "name": "delta stream gap reports open bounds, re-subscribes and resumes from a snapshot, which ends the resync wait (sleeps past the resync timeout plus one watchdog tick)",
    "call": { "kind": "stream", "stream": "v1.ticker.d", "resync_timeout_ms": 300 },
    "steps": [
      { "push": [101, 100] },
      { "push": [105, 103] },
      { "wait_acks": 2 },
      { "sleep_ms": "$watchdog_interval+300" },
      { "push": [106, 105] }
    ],
    "expect": {
      "items": [0, 101, 0, 106],
      "gaps": [{ "reason": "sequence_mismatch", "after": 101, "through": null, "frame": [105, 103] }],
      "subscribes": 2
    }
  },
  {
    "name": "snapshot stream gap reports closed bounds without re-subscribing",
    "call": { "kind": "stream", "stream": "v1.ticker.s" },
    "steps": [{ "push": [103, 101] }],
    "expect": {
      "items": [0, 103],
      "gaps": [{ "reason": "sequence_mismatch", "after": 100, "through": 101 }],
      "subscribes": 1
    }
  },
  {
    "name": "no snapshot within the resync timeout reconnects; frames before the reply are dropped",
    "call": { "kind": "stream", "stream": "v1.ticker.d", "resync_timeout_ms": 300 },
    "steps": [
      { "push": [101, 100] },
      { "ignore_subscribes": 1 },
      { "push": [110, 108] },
      { "push": [111, 110] },
      { "wait_reconnects": 1 },
      { "wait_acks": 2 }
    ],
    "expect": {
      "items": [0, 101, 0],
      "gaps": [
        { "reason": "sequence_mismatch", "after": 101, "through": null },
        { "reason": "disconnect", "after": null, "through": null }
      ],
      "subscribes": 3
    }
  },
