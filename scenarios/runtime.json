      { "wait_dropped": 4 }
    ],
    "expect": { "items": [104, 105], "gaps": [], "subscribes": 1 }
  },
  {
    "name": "session logs in again at the renewal ratio, then the socket reconnects with the new cookie",
    "call": { "kind": "stream", "stream": "v1.order", "cookie_max_age_s": 2 },
    "steps": [{ "wait_reconnects": 1 }, { "wait_acks": 2 }],
    "expect": {
      "logins": 2,
      "relogin_after_ms": ["$session_renew_at*2000-50", 3000],
      "session_rotated": [2],
      "handshake_logins": [1, 2],
      "items": [0, 0],
      "gaps": [{ "reason": "disconnect", "after": 100, "through": null }],
      "subscribes": 2
    }
  },
  {
    "name": "pages are read one fetch at a time and go on after an empty page",
    "call": { "kind": "pages" },
    "replies": [{ "next": "a" }, { "next": "" }],
    "expect": { "outcome": "ok", "pages": 2, "cursors": [null, "a"] }
  },
  {
    "name": "pages stop before fetching a cursor again",
    "call": { "kind": "pages" },
    "replies": [{ "next": "a" }],
    "expect": { "outcome": "pagination_cycle", "cursor": "a", "pages": 2, "cursors": [null, "a"] }
  },
  {
    "name": "a failed page fetch ends the pages without a retry",
    "call": { "kind": "pages" },
    "replies": [{ "fail": true }],
    "expect": { "outcome": "fetch_error", "pages": 0, "cursors": [null] }
  },
  {
    "name": "pages fetch nothing more after the reader stops",
    "call": { "kind": "pages", "take": 1 },
    "replies": [{ "next": "a" }],
    "expect": { "outcome": "ok", "pages": 1, "cursors": [null] }
  },
  {
    "name": "backfill keeps continuity unproven, even when history is exhausted",
    "call": { "kind": "backfill", "gap": { "reason": "disconnect", "after": 10, "through": null } },
    "replies": [{ "next": "a" }, { "next": "" }],
    "expect": {
      "outcome": "ok",
      "pages": 2,
      "cursors": [null, "a"],
      "history_exhausted": [false, true],
      "continuity": "unproven"
    }
  }
]
