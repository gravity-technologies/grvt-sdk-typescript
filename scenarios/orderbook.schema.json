{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared order-book scenarios (orderbook.json)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["name", "mode", "steps"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "mode": { "enum": ["delta", "snapshot"] },
      "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
    },
    "additionalProperties": false
  },
  "$defs": {
    "prices": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" } },
    "step": {
      "type": "object",
      "oneOf": [
        {
          "required": ["action", "frame"],
          "properties": {
            "action": { "enum": ["apply", "reset"] },
            "frame": { "$ref": "#/$defs/frame" },
            "bids": { "$ref": "#/$defs/prices" },
            "asks": { "$ref": "#/$defs/prices" },
            "error": {
              "enum": [
                "gap",
                "invalid_level",
                "not_ready",
                "out_of_order",
                "reset_required",
                "snapshot_required",
                "wrong_stream"
              ]
            }
          },
          "additionalProperties": false,
          "oneOf": [{ "required": ["bids", "asks"], "not": { "required": ["error"] } }, { "required": ["error"], "not": { "anyOf": [{ "required": ["bids"] }, { "required": ["asks"] }] } }]
        },
        {
          "required": ["action", "reason"],
          "properties": { "action": { "const": "gap" }, "reason": { "enum": ["sequence_mismatch", "disconnect", "overflow"] } },
          "additionalProperties": false
        },
        {
          "required": ["action"],
          "properties": { "action": { "const": "invalidate" } },
          "additionalProperties": false
        }
      ]
    },
    "frame": {
      "type": "object",
      "required": ["stream", "selector", "sequence_number", "prev_sequence_number", "feed"],
      "properties": {
        "stream": { "type": "string" },
        "selector": { "type": "string" },
        "sequence_number": { "type": "string", "pattern": "^[0-9]+$" },
        "prev_sequence_number": { "type": "string", "pattern": "^[0-9]+$" },
        "feed": {
          "type": "object",
          "required": ["instrument", "event_time", "bids", "asks"],
          "properties": {
            "instrument": { "type": "string" },
            "event_time": { "type": "string", "pattern": "^[0-9]+$" },
            "bids": { "$ref": "#/$defs/levels" },
            "asks": { "$ref": "#/$defs/levels" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["price", "size", "num_orders"],
        "properties": {
          "price": { "type": "string" },
          "size": { "type": "string" },
          "num_orders": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  }
}
